#!/bin/bash
# Claude Code TTS control CLI.
# Three providers: edge-tts (default, free), openai (paid, key from Keychain) and
# google (Chirp 3 HD, free tier guarded by a local monthly char counter, key from Keychain).
# edge-tts knobs: voice, rate, pitch.  openai knobs: openai-voice, openai-model, speed.
# google knobs: google-voice, google-speed.
set -euo pipefail

KEYCHAIN_SERVICE="claude-code-tts"
KEYCHAIN_ACCOUNT_OPENAI="openai"
KEYCHAIN_ACCOUNT_GOOGLE="google"
GOOGLE_USAGE_FILE_DEFAULT="$HOME/.config/claude-code-tts/google-usage.json"

# Resolve symlinks so the CLI works when invoked via ~/.local/bin/tts too.
_self="$0"
while [[ -L "$_self" ]]; do
    _link="$(readlink "$_self")"
    if [[ "$_link" = /* ]]; then
        _self="$_link"
    else
        _self="$(cd "$(dirname "$_self")" && cd "$(dirname "$_link")" && pwd)/$(basename "$_link")"
    fi
done
REPO_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
TTS_FLAG="$HOME/.config/claude-code-tts/enabled"
TTS_PORT="${TTS_PORT:-7852}"
AGENT_LABEL="com.claude-code.tts"
PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"
UID_NUM="$(id -u)"
DOMAIN="gui/${UID_NUM}"
SERVICE="${DOMAIN}/${AGENT_LABEL}"

mkdir -p "$(dirname "$TTS_FLAG")"

have_agent() {
  launchctl print "$SERVICE" >/dev/null 2>&1
}
agent_running() {
  launchctl print "$SERVICE" 2>/dev/null | grep -q 'state = running'
}
health_ok() {
  curl -sf --max-time 1 "http://127.0.0.1:${TTS_PORT}/health" >/dev/null 2>&1
}

ensure_agent_loaded() {
  if ! have_agent; then
    if [[ -f "$PLIST" ]]; then
      launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null || true
    else
      echo "error: launchd plist missing at $PLIST — run: tts install" >&2
      return 1
    fi
  fi
}

cmd_on() {
  echo 1 > "$TTS_FLAG"
  ensure_agent_loaded
  if ! agent_running; then
    launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
  fi
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      echo "TTS: on (server healthy on :$TTS_PORT)"
      return 0
    fi
    sleep 0.5
  done
  echo "TTS: enabled, but server not responding on :$TTS_PORT yet — check: tts logs" >&2
}

cmd_off() {
  echo 0 > "$TTS_FLAG"
  curl -sf --max-time 1 -X POST "http://127.0.0.1:${TTS_PORT}/stop" >/dev/null 2>&1 || true
  echo "TTS: off (server left running; it's idle)"
}

cmd_toggle() {
  if [[ -f "$TTS_FLAG" ]] && [[ "$(cat "$TTS_FLAG")" == "1" ]]; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_status() {
  local enabled="no"
  [[ -f "$TTS_FLAG" ]] && [[ "$(cat "$TTS_FLAG")" == "1" ]] && enabled="yes"
  echo "enabled: $enabled"
  echo "flag:    $TTS_FLAG"
  echo "repo:    $REPO_DIR"
  if health_ok; then
    local info
    info=$(curl -sf --max-time 1 "http://127.0.0.1:${TTS_PORT}/health")
    echo "server:  running ($info)"
    local locked
    locked=$(echo "$info" | jq -r '.locked // false')
    if [[ "$locked" == "true" ]]; then
      echo "lock:    ACTIVE (microphone recording — TTS suppressed)"
    fi
    # The usage block exists only when provider=google; `// empty` keeps the
    # lines out for other providers (and for an older server without the field).
    local g_used g_limit g_pct g_month g_reason g_at
    g_used=$(echo "$info" | jq -r '.config.usage.used // empty' 2>/dev/null || true)
    if [[ -n "$g_used" ]]; then
      g_limit=$(echo "$info" | jq -r '.config.usage.limit // empty' 2>/dev/null || true)
      g_pct=$(echo "$info" | jq -r '.config.usage.percent // empty' 2>/dev/null || true)
      g_month=$(echo "$info" | jq -r '.config.usage.month // empty' 2>/dev/null || true)
      echo "google:  ${g_used}/${g_limit} chars (${g_pct}%) month=${g_month} (Pacific)"
      if echo "$info" | jq -e '(.config.usage.flags // []) | index("exhausted")' >/dev/null 2>&1; then
        echo "google:  exhausted -> edge-tts until next month"
      fi
      g_reason=$(echo "$info" | jq -r '.config.last_fallback.reason // empty' 2>/dev/null || true)
      if [[ -n "$g_reason" ]]; then
        g_at=$(echo "$info" | jq -r '.config.last_fallback.at // empty' 2>/dev/null || true)
        echo "fallback: ${g_reason} at ${g_at}"
      fi
    fi
  else
    echo "server:  down"
  fi
  if have_agent; then
    local state
    state=$(launchctl print "$SERVICE" 2>/dev/null | awk -F' = ' '/state =/{print $2; exit}')
    echo "launchd: loaded (state=${state:-unknown})"
  else
    echo "launchd: not loaded"
  fi
}

cmd_test() {
  # Default payload must include a TL;DR block — otherwise it silently returns 204
  # when TTS_TLDR_ONLY=1 (the default) and users think the test failed.
  local text="${1:-Это проверка голоса. Сейчас прозвучит только блок TL;DR.

## TL;DR
Всё работает.}"
  if ! health_ok; then
    echo "server is down — starting..." >&2
    cmd_on || true
  fi
  curl -sf --max-time 5 -X POST "http://127.0.0.1:${TTS_PORT}/speak" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg t "$text" '{text:$t}')" || {
      echo "speak failed" >&2
      return 1
    }
  echo
}

cmd_restart() {
  ensure_agent_loaded
  launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      echo "restarted"
      return 0
    fi
    sleep 0.5
  done
  echo "restart: server not responding yet — check: tts logs" >&2
}

cmd_install() {
  bash "$REPO_DIR/install.sh"
}

cmd_uninstall() {
  bash "$REPO_DIR/uninstall.sh" "$@"
}

cmd_logs() {
  local log="$REPO_DIR/logs/server.log"
  if [[ ! -f "$log" ]]; then
    echo "no logs yet at $log"
    return 0
  fi
  tail -n 50 -f "$log"
}

# Write one key into plist's EnvironmentVariables dict (no restart).
_set_env_value() {
  local key="$1" value="$2"
  if [[ ! -f "$PLIST" ]]; then
    echo "error: plist missing, run: tts install" >&2
    return 1
  fi
  /usr/libexec/PlistBuddy -c "Set :EnvironmentVariables:$key $value" "$PLIST" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:$key string $value" "$PLIST"
}

# Bootout + bootstrap launchd agent, wait for /health.
_reload_agent() {
  launchctl bootout "$DOMAIN" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "$DOMAIN" "$PLIST"
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      return 0
    fi
    sleep 0.5
  done
  echo "server not responding yet — check: tts logs" >&2
  return 1
}

_update_env() {
  _set_env_value "$1" "$2" && _reload_agent
}

cmd_voice() {
  local name="${1:?usage: tts voice <voice-name> (e.g. ru-RU-SvetlanaNeural, ru-RU-DmitryNeural, en-US-AriaNeural)}"
  _update_env TTS_VOICE "$name" && echo "voice: $name (server restarted)"
}

cmd_rate() {
  local value="${1:?usage: tts rate <value>  (e.g. +0%, +15%, -10%)}"
  if [[ ! "$value" =~ ^[+-][0-9]+%$ ]]; then
    echo "error: rate must look like +15% or -10%" >&2
    return 2
  fi
  _update_env TTS_RATE "$value" && echo "rate: $value (server restarted)"
}

cmd_pitch() {
  local value="${1:?usage: tts pitch <value>  (e.g. +0Hz, +50Hz, -20Hz)}"
  if [[ ! "$value" =~ ^[+-][0-9]+Hz$ ]]; then
    echo "error: pitch must look like +50Hz or -20Hz" >&2
    return 2
  fi
  _update_env TTS_PITCH "$value" && echo "pitch: $value (server restarted)"
}

cmd_voices() {
  local py="$REPO_DIR/venv/bin/python"
  if [[ ! -x "$py" ]]; then
    echo "venv missing — run: tts install" >&2
    return 1
  fi
  "$py" -c 'import asyncio, edge_tts; voices = asyncio.run(edge_tts.list_voices()); [print(v["ShortName"], "—", v.get("Gender",""), v.get("Locale","")) for v in voices if v["Locale"].startswith(("ru","en"))]'
}

# Voice-per-model matrix. Single source of truth for: `tts openai-voices`,
# model↔voice validation in `openai-voice`/`openai-model`/`doctor`, and
# install.sh's post-render sanity check.
#
# Source: https://developers.openai.com/api/docs/guides/text-to-speech
#   - tts-1 / tts-1-hd: 9 voices (no ballad, verse, marin, cedar)
#   - gpt-4o-mini-tts:  13 voices (superset)
# Keep the bash-3.2-compatible case form — macOS ships bash 3.2 as /bin/bash.
_openai_voices_for_model() {
  case "$1" in
    tts-1|tts-1-hd)
      echo "alloy ash coral echo fable nova onyx sage shimmer"
      ;;
    gpt-4o-mini-tts)
      echo "alloy ash ballad coral echo fable marin nova onyx sage shimmer verse cedar"
      ;;
    *)
      return 1
      ;;
  esac
}

# List of every known OpenAI TTS model. Used by _openai_model_for_voice_hint
# to suggest which model supports a voice the user tried to set.
_openai_known_models() {
  echo "tts-1 tts-1-hd gpt-4o-mini-tts"
}

# True (exit 0) if $voice is supported by $model. Non-zero for unknown model
# or unsupported voice.
_openai_voice_supported_by() {
  local model="$1" voice="$2" v voices
  voices=$(_openai_voices_for_model "$model") || return 2
  for v in $voices; do
    [[ "$v" == "$voice" ]] && return 0
  done
  return 1
}

# Suggest a model that supports $voice, or empty if none. Lets error messages
# turn "voice X is not valid here" into "voice X works with model Y, run: ...".
_openai_model_for_voice_hint() {
  local voice="$1" m
  for m in $(_openai_known_models); do
    if _openai_voice_supported_by "$m" "$voice"; then
      echo "$m"
      return 0
    fi
  done
  return 1
}

# Read one EnvironmentVariables key from the installed plist, falling back to
# the given default. Used by validation paths that must know the *current*
# other half of the model↔voice pair, not just the new value the user is
# setting. Mirrors the server's own defaults so the CLI and server agree.
_openai_get_plist_value() {
  local key="$1" default="$2"
  if [[ -f "$PLIST" ]]; then
    /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$PLIST" 2>/dev/null \
      || echo "$default"
  else
    echo "$default"
  fi
}

# --- Keychain key helpers (shared by openai and google) ---------------------------------

_key_stored() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" >/dev/null 2>&1
}

# Print a short description of what is wrong with the stored key's shape; print
# nothing if it looks fine (or if no key is stored — use _key_stored for that).
# Shape checks are heuristics that catch typos and the legacy bug where the
# `security -w` tty prompt got a password typed into it instead of the API key.
_key_shape_problem() {
  local account="$1" stored
  stored=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$account" -w 2>/dev/null) || return 0
  case "$account" in
    "$KEYCHAIN_ACCOUNT_OPENAI")
      if [[ "$stored" != sk-* ]] || [[ "${#stored}" -lt 40 ]]; then
        echo "expected sk-... with 40+ chars"
      fi
      ;;
    "$KEYCHAIN_ACCOUNT_GOOGLE")
      # Real Google API keys are ~39 chars starting with AIza.
      if [[ "$stored" != AIza* ]] || [[ "${#stored}" -lt 35 ]] || [[ "${#stored}" -gt 45 ]]; then
        echo "expected AIza... with 35-45 chars"
      fi
      ;;
  esac
}

# Print a one-line hint if the Keychain key for <openai|google> is missing or
# obviously malformed. Returns non-zero so callers can gate follow-up output.
_warn_key_unusable() {
  local kind="$1" account label
  case "$kind" in
    openai) account="$KEYCHAIN_ACCOUNT_OPENAI"; label="OpenAI" ;;
    google) account="$KEYCHAIN_ACCOUNT_GOOGLE"; label="Google" ;;
    *) echo "internal error: unknown key kind '$kind'" >&2; return 2 ;;
  esac
  if ! _key_stored "$account"; then
    echo "! no $label API key in Keychain — run: tts $kind-key" >&2
    return 1
  fi
  local problem
  problem=$(_key_shape_problem "$account")
  if [[ -n "$problem" ]]; then
    echo "! stored $label key looks malformed ($problem) — re-run: tts $kind-key" >&2
    return 1
  fi
  return 0
}

# Store a key: ask before replacing an existing one, then let `security` prompt
# on the tty (hidden input, asked twice). The key never appears in our argv or
# in `ps`. After storing, the shape is checked and a malformed key only warns —
# we never delete what the user just typed.
_store_key() {
  local account="$1" label="$2" kind="$3"
  if _key_stored "$account"; then
    if [[ ! -t 0 ]]; then
      echo "error: $label key already stored and stdin is not a terminal — cannot confirm replace" >&2
      return 2
    fi
    local answer
    read -r -p "$label key already stored, replace? [y/N] " answer
    if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
      echo "aborted, stored key unchanged"
      return 0
    fi
  fi
  echo "Paste the $label API key at the prompt below (input is hidden, asked twice)."
  if ! security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$account" -w; then
    echo "error: failed to store key in Keychain" >&2
    return 1
  fi
  echo "$label key stored in Keychain (service=$KEYCHAIN_SERVICE account=$account)"
  _warn_key_unusable "$kind" || true
  if health_ok; then
    _reload_agent && echo "server restarted (key reloaded)"
  fi
}

_clear_key() {
  local account="$1" label="$2"
  if security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$account" >/dev/null 2>&1; then
    echo "$label key removed from Keychain"
  else
    echo "no $label key was stored"
  fi
  if health_ok; then
    _reload_agent && echo "server restarted"
  fi
}

cmd_provider() {
  local name="${1:?usage: tts provider <edge-tts|openai|google>}"
  case "$name" in
    edge-tts|openai|google) ;;
    *) echo "error: provider must be 'edge-tts', 'openai' or 'google'" >&2; return 2 ;;
  esac
  _update_env TTS_PROVIDER "$name" && echo "provider: $name (server restarted)"
  # Nudge the user if they switched to a keyed provider without a usable key —
  # openai would 401 on the next /speak, google would silently fall back to
  # edge-tts, and the only trace of either is logs/server.log.
  if [[ "$name" == "openai" || "$name" == "google" ]]; then
    _warn_key_unusable "$name" || true
  fi
}

cmd_openai_key() {
  _store_key "$KEYCHAIN_ACCOUNT_OPENAI" "OpenAI" openai
}

cmd_openai_key_clear() {
  _clear_key "$KEYCHAIN_ACCOUNT_OPENAI" "OpenAI"
}

cmd_google_key() {
  _store_key "$KEYCHAIN_ACCOUNT_GOOGLE" "Google" google
}

cmd_google_key_clear() {
  _clear_key "$KEYCHAIN_ACCOUNT_GOOGLE" "Google"
}

cmd_google_voice() {
  local name="${1:?usage: tts google-voice <name>  (e.g. ru-RU-Chirp3-HD-Aoede, en-US-Chirp3-HD-Puck)}"
  if [[ ! "$name" =~ ^[a-z]{2,3}-[A-Z]{2}-Chirp3-HD-[A-Za-z]+$ ]]; then
    echo "error: voice must look like ru-RU-Chirp3-HD-Aoede (Chirp 3 HD voices only)" >&2
    return 2
  fi
  _update_env GOOGLE_TTS_VOICE "$name" && echo "google voice: $name (server restarted)"
}

cmd_google_speed() {
  local value="${1:?usage: tts google-speed <value>  (0.25 to 2.0, e.g. 1.1)}"
  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "error: speed must be a positive number (e.g. 0.9, 1.25, 2.0)" >&2
    return 2
  fi
  # Chirp 3 HD accepts 0.25–2.0 (narrower than OpenAI's 4.0).
  awk -v v="$value" 'BEGIN{ if (v+0 < 0.25 || v+0 > 2.0) exit 1 }' || {
    echo "error: speed must be between 0.25 and 2.0" >&2
    return 2
  }
  _update_env GOOGLE_TTS_SPEED "$value" && echo "google speed: $value (server restarted)"
}

cmd_openai_voice() {
  local name="${1:?usage: tts openai-voice <name> (e.g. nova, alloy, ballad — see: tts openai-voices)}"
  # Validate against the *currently-configured* model so the user catches
  # pair mismatches (e.g. voice=ballad with model=tts-1) at CLI time instead
  # of much later, as a 400 buried in logs/server.log.
  local current_model
  current_model=$(_openai_get_plist_value OPENAI_TTS_MODEL "gpt-4o-mini-tts")
  if ! _openai_voice_supported_by "$current_model" "$name"; then
    echo "error: voice '$name' is not supported by model '$current_model'" >&2
    echo "       supported for $current_model: $(_openai_voices_for_model "$current_model")" >&2
    local suggested
    if suggested=$(_openai_model_for_voice_hint "$name"); then
      echo "       hint: '$name' works with model '$suggested'" >&2
      echo "             run first: tts openai-model $suggested" >&2
    else
      echo "       hint: see full matrix with: tts openai-voices" >&2
    fi
    return 2
  fi
  _update_env OPENAI_TTS_VOICE "$name" && echo "openai voice: $name (server restarted)"
}

cmd_openai_model() {
  local name="${1:?usage: tts openai-model <tts-1|tts-1-hd|gpt-4o-mini-tts>}"
  case "$name" in
    tts-1|tts-1-hd|gpt-4o-mini-tts) ;;
    *) echo "error: unknown model '$name' (expected tts-1, tts-1-hd, or gpt-4o-mini-tts)" >&2; return 2 ;;
  esac
  # Refuse to switch to a model that doesn't support the *currently-configured*
  # voice — otherwise the next /speak returns 400 and only logs/server.log
  # explains why. The fix path is printed so users can do it in one shot.
  local current_voice
  current_voice=$(_openai_get_plist_value OPENAI_TTS_VOICE "nova")
  if ! _openai_voice_supported_by "$name" "$current_voice"; then
    echo "error: current voice '$current_voice' is NOT supported by model '$name'" >&2
    echo "       supported for $name: $(_openai_voices_for_model "$name")" >&2
    echo "       fix: run 'tts openai-voice <one-of-above>' first, then 'tts openai-model $name'" >&2
    return 2
  fi
  _update_env OPENAI_TTS_MODEL "$name" && echo "openai model: $name (server restarted)"
}

cmd_speed() {
  local value="${1:?usage: tts speed <value>  (0.25 to 4.0, e.g. 1.25)}"
  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "error: speed must be a positive number (e.g. 0.9, 1.25, 2.0)" >&2
    return 2
  fi
  # OpenAI accepts 0.25–4.0; bounds-check here so errors surface before restart.
  awk -v v="$value" 'BEGIN{ if (v+0 < 0.25 || v+0 > 4.0) exit 1 }' || {
    echo "error: speed must be between 0.25 and 4.0" >&2
    return 2
  }
  _update_env OPENAI_TTS_SPEED "$value" && echo "openai speed: $value (server restarted)"
}

cmd_openai_voices() {
  # Print the model↔voice matrix as a two-column table so the user can see at
  # a glance which voices are legal for which model. The data comes from
  # _openai_voices_for_model (single source of truth).
  local m current_model current_voice
  current_model=$(_openai_get_plist_value OPENAI_TTS_MODEL "gpt-4o-mini-tts")
  current_voice=$(_openai_get_plist_value OPENAI_TTS_VOICE "nova")

  echo "OpenAI TTS voices per model:"
  echo
  printf "  %-16s  %s\n" "Model" "Supported voices"
  printf "  %-16s  %s\n" "----------------" "----------------"
  for m in $(_openai_known_models); do
    printf "  %-16s  %s\n" "$m" "$(_openai_voices_for_model "$m")"
  done
  echo
  echo "Current:  model=$current_model  voice=$current_voice"
  if ! _openai_voice_supported_by "$current_model" "$current_voice"; then
    echo "          ! mismatch — '$current_voice' is not valid for '$current_model'"
  fi
  echo
  echo "Change:   tts openai-model <name>   tts openai-voice <name>"
}

cmd_openai_instructions() {
  local value="${1:?usage: tts openai-instructions \"<text>\"  (one line; e.g. \"Speak calmly with a warm tone\")}"
  # PlistBuddy "Set :Key value" treats everything past the key as the value —
  # spaces and most punctuation are fine. Newlines, however, corrupt the plist
  # and would break launchd silently, so reject them up front.
  if [[ "$value" == *$'\n'* ]]; then
    echo "error: instructions must be a single line (no embedded newlines)" >&2
    return 2
  fi
  _update_env OPENAI_TTS_INSTRUCTIONS "$value" \
    && echo "openai instructions: saved (server restarted)"
  # Instructions only take effect on gpt-4o-mini-tts. Don't block — the user
  # may be pre-configuring before switching model — but surface a warn so the
  # silent drop in the provider is still visible.
  local current_model
  current_model=$(_openai_get_plist_value OPENAI_TTS_MODEL "gpt-4o-mini-tts")
  if [[ "$current_model" != "gpt-4o-mini-tts" ]]; then
    echo "! note: instructions are only honored by gpt-4o-mini-tts" >&2
    echo "        current model is '$current_model' — hint is stored but ignored" >&2
    echo "        enable with: tts openai-model gpt-4o-mini-tts" >&2
  fi
}

cmd_openai_instructions_clear() {
  if [[ ! -f "$PLIST" ]]; then
    echo "error: plist missing, run: tts install" >&2
    return 1
  fi
  if /usr/libexec/PlistBuddy -c "Delete :EnvironmentVariables:OPENAI_TTS_INSTRUCTIONS" "$PLIST" 2>/dev/null; then
    _reload_agent && echo "openai instructions: cleared (server restarted)"
  else
    echo "openai instructions: not set (no change)"
  fi
}

cmd_openai_instructions_show() {
  # Read-only view — the stored hint can be long, so `tts config` would line-wrap
  # it into noise. Give users a dedicated command that prints just the value.
  local value
  value=$(_openai_get_plist_value OPENAI_TTS_INSTRUCTIONS "")
  if [[ -z "$value" ]]; then
    echo "(not set)"
  else
    echo "$value"
  fi
}

cmd_tldr_fallback() {
  local value="${1:?usage: tts tldr-fallback \"<text>\"  (spoken when TL;DR is missing; one line)}"
  # Same PlistBuddy reasoning as openai-instructions: spaces fine, newlines
  # would corrupt the plist.
  if [[ "$value" == *$'\n'* ]]; then
    echo "error: fallback text must be a single line (no embedded newlines)" >&2
    return 2
  fi
  _update_env TTS_TLDR_FALLBACK_TEXT "$value" \
    && echo "tldr fallback: saved (server restarted)"
  # Warn if TLDR_ONLY is off — the fallback never fires in that mode because
  # the full message is spoken anyway. Not a hard error: the user may be
  # pre-configuring before flipping TLDR_ONLY back on.
  local tldr_mode
  tldr_mode=$(_openai_get_plist_value TTS_TLDR_ONLY "1")
  if [[ "$tldr_mode" != "1" ]]; then
    echo "! note: TTS_TLDR_ONLY=0 — fallback is stored but never fires" >&2
    echo "        enable with: tts tldr on" >&2
  fi
}

cmd_tldr_fallback_clear() {
  if [[ ! -f "$PLIST" ]]; then
    echo "error: plist missing, run: tts install" >&2
    return 1
  fi
  if /usr/libexec/PlistBuddy -c "Delete :EnvironmentVariables:TTS_TLDR_FALLBACK_TEXT" "$PLIST" 2>/dev/null; then
    _reload_agent && echo "tldr fallback: cleared (server restarted; silent-skip restored)"
  else
    echo "tldr fallback: not set (no change)"
  fi
}

cmd_tldr_fallback_show() {
  local value
  value=$(_openai_get_plist_value TTS_TLDR_FALLBACK_TEXT "")
  if [[ -z "$value" ]]; then
    echo "(not set — server stays silent when TL;DR block is missing)"
  else
    echo "$value"
  fi
}

cmd_reset() {
  # Resets edge-tts knobs only. Does not touch TTS_PROVIDER, OpenAI settings,
  # or the Keychain-stored key.
  _set_env_value TTS_VOICE "ru-RU-SvetlanaNeural" || return 1
  _set_env_value TTS_RATE  "+0%"                  || return 1
  _set_env_value TTS_PITCH "+0Hz"                 || return 1
  _reload_agent && echo "reset: voice=ru-RU-SvetlanaNeural, rate=+0%, pitch=+0Hz (edge-tts knobs only)"
}

cmd_tldr() {
  local mode="${1:?usage: tts tldr <on|off>}"
  local want
  case "$mode" in
    on)  want="1" ;;
    off) want="0" ;;
    *)   echo "usage: tts tldr <on|off>" >&2; return 2 ;;
  esac

  # Skip the launchd bootout+bootstrap if the flag is already set to the
  # requested value — re-loading needlessly would interrupt active playback.
  if [[ -f "$PLIST" ]]; then
    local current
    current=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:TTS_TLDR_ONLY" "$PLIST" 2>/dev/null || echo "")
    if [[ "$current" == "$want" ]]; then
      echo "tldr-only: already $mode (no change)"
      return 0
    fi
  fi

  if [[ "$mode" == "on" ]]; then
    _update_env TTS_TLDR_ONLY "1" && echo "tldr-only: on  (speak only the TL;DR block; silent if absent)"
  else
    _update_env TTS_TLDR_ONLY "0" && echo "tldr-only: off (speak the full message)"
  fi
}

# Defaults mirror src/claude_code_tts/server.py — shown by cmd_config when the
# plist key is absent so users don't confuse "(unset)" with "(no effective default)".
# Case-based lookup keeps bash 3.2 compatibility (macOS default /bin/bash).
_default_for_key() {
  case "$1" in
    TTS_PROVIDER)     echo "edge-tts" ;;
    TTS_VOICE)        echo "ru-RU-SvetlanaNeural" ;;
    TTS_RATE)         echo "+0%" ;;
    TTS_PITCH)        echo "+0Hz" ;;
    OPENAI_TTS_MODEL) echo "gpt-4o-mini-tts" ;;
    OPENAI_TTS_VOICE) echo "nova" ;;
    OPENAI_TTS_SPEED) echo "1.0" ;;
    TTS_TLDR_ONLY)    echo "1" ;;
    TTS_MAX_CHARS)    echo "1500" ;;
    TTS_PORT)         echo "7852" ;;
    TTS_LOCK_FILE)    echo "/tmp/nl-recording.lock" ;;
    TTS_RESPECT_LOCK) echo "1" ;;
    GOOGLE_TTS_VOICE) echo "ru-RU-Chirp3-HD-Aoede" ;;
    GOOGLE_TTS_SPEED) echo "1.0" ;;
    GOOGLE_TTS_MONTHLY_CHAR_LIMIT) echo "990000" ;;
    GOOGLE_TTS_USAGE_FILE) echo "$GOOGLE_USAGE_FILE_DEFAULT" ;;
    *)                echo "" ;;
  esac
}

cmd_config() {
  if [[ ! -f "$PLIST" ]]; then
    echo "plist missing, run: tts install" >&2
    return 1
  fi
  echo "Config from $PLIST"
  echo "(edit with 'tts provider|voice|rate|pitch|openai-voice|openai-model|speed|google-voice|google-speed' or PlistBuddy + 'tts restart')"
  echo
  local keys=(
    TTS_PROVIDER
    TTS_VOICE TTS_RATE TTS_PITCH
    OPENAI_TTS_MODEL OPENAI_TTS_VOICE OPENAI_TTS_SPEED OPENAI_TTS_INSTRUCTIONS
    GOOGLE_TTS_VOICE GOOGLE_TTS_SPEED GOOGLE_TTS_MONTHLY_CHAR_LIMIT GOOGLE_TTS_USAGE_FILE
    TTS_TLDR_ONLY TTS_TLDR_FALLBACK_TEXT
    TTS_MAX_CHARS TTS_PORT TTS_LOCK_FILE TTS_RESPECT_LOCK PYTHONPATH
  )
  local key val default_hint
  for key in "${keys[@]}"; do
    if val=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$PLIST" 2>/dev/null); then
      printf "  %-30s = %s\n" "$key" "$val"
    else
      default_hint=$(_default_for_key "$key")
      if [[ -n "$default_hint" ]]; then
        printf "  %-30s = (unset, default=%s)\n" "$key" "$default_hint"
      else
        printf "  %-30s = (unset)\n" "$key"
      fi
    fi
  done
  echo
  if _key_stored "$KEYCHAIN_ACCOUNT_OPENAI"; then
    printf "  %-30s = %s\n" "OpenAI key" "(stored in Keychain)"
  else
    printf "  %-30s = %s\n" "OpenAI key" "(not stored — run: tts openai-key)"
  fi
  if _key_stored "$KEYCHAIN_ACCOUNT_GOOGLE"; then
    printf "  %-30s = %s\n" "Google key" "(stored in Keychain)"
  else
    printf "  %-30s = %s\n" "Google key" "(not stored — run: tts google-key)"
  fi
}

cmd_update() {
  if ! git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    echo "error: $REPO_DIR is not a git checkout — can't update" >&2
    return 1
  fi
  echo "→ git pull --rebase in $REPO_DIR"
  if ! git -C "$REPO_DIR" pull --rebase; then
    echo "update: git pull failed (resolve conflicts, then re-run)" >&2
    return 1
  fi
  echo "→ running install.sh"
  bash "$REPO_DIR/install.sh"
}

# Print the first command registered for hook event $2 that contains $3, or
# nothing. Scans every entry: other tools (e.g. iTerm2's cc-status) also register
# Stop/SessionStart hooks and may sit before ours, so checking only index [0]
# reported a healthy install as broken.
_find_hook_command() {
  jq -r --arg ev "$2" --arg needle "$3" \
    '[.hooks[$ev][]?.hooks[]?.command] | map(select(contains($needle))) | .[0] // empty' \
    "$1" 2>/dev/null || true
}

# Comma-separated list of every command registered for hook event $2 (for error messages).
_list_hook_commands() {
  local out
  out=$(jq -r --arg ev "$2" '[.hooks[$ev][]?.hooks[]?.command] | join(", ")' "$1" 2>/dev/null || true)
  echo "${out:-(none)}"
}

cmd_doctor() {
  local fails=0
  _ok()   { printf '  \033[0;32m✓\033[0m %s\n' "$1"; }
  _fail() { printf '  \033[0;31m✗\033[0m %s\n' "$1" >&2; fails=$((fails + 1)); }
  _warn() { printf '  \033[1;33m!\033[0m %s\n' "$1"; }

  echo "== Dependencies =="
  for bin in python3 afplay jq git curl launchctl; do
    if command -v "$bin" >/dev/null 2>&1; then
      _ok "$bin: $(command -v "$bin")"
    else
      _fail "$bin not on PATH"
    fi
  done
  if command -v python3 >/dev/null 2>&1; then
    local py_ver
    py_ver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    local maj min
    maj=$(echo "$py_ver" | cut -d. -f1)
    min=$(echo "$py_ver" | cut -d. -f2)
    if [[ "$maj" -ge 3 ]] && [[ "$min" -ge 10 ]]; then
      _ok "python3 version: $py_ver (>= 3.10 required)"
    else
      _fail "python3 version: $py_ver — need >= 3.10"
    fi
  fi

  echo
  echo "== Repo =="
  _ok "repo: $REPO_DIR"
  if [[ -d "$REPO_DIR/.git" ]]; then
    local branch origin
    branch=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    origin=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "(no origin)")
    _ok "git branch: $branch, origin: $origin"
  else
    _warn "not a git checkout — 'tts update' will not work"
  fi

  echo
  echo "== venv + providers =="
  local venv_py="$REPO_DIR/venv/bin/python"
  local active_provider="edge-tts"
  if [[ -f "$PLIST" ]]; then
    active_provider=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:TTS_PROVIDER" "$PLIST" 2>/dev/null || echo "edge-tts")
  fi
  _ok "active provider: $active_provider"
  if [[ -x "$venv_py" ]]; then
    _ok "venv python: $venv_py"
    if "$venv_py" -c 'import edge_tts; print(edge_tts.__version__)' 2>/dev/null >/dev/null; then
      local v
      v=$("$venv_py" -c 'import edge_tts; print(edge_tts.__version__)')
      _ok "edge-tts importable (version $v)"
    else
      _fail "edge-tts not importable — run: tts install"
    fi
    if "$venv_py" -c 'import openai; print(openai.__version__)' 2>/dev/null >/dev/null; then
      local ov
      ov=$("$venv_py" -c 'import openai; print(openai.__version__)')
      _ok "openai importable (version $ov)"
    else
      if [[ "$active_provider" == "openai" ]]; then
        _fail "openai not importable but provider=openai — run: tts update"
      else
        _warn "openai not importable (ok — provider is $active_provider; run 'tts update' to install)"
      fi
    fi
    if _key_stored "$KEYCHAIN_ACCOUNT_OPENAI"; then
      local openai_problem
      openai_problem=$(_key_shape_problem "$KEYCHAIN_ACCOUNT_OPENAI")
      if [[ -z "$openai_problem" ]]; then
        _ok "OpenAI key present in Keychain (format looks valid)"
      else
        _fail "OpenAI key in Keychain looks malformed ($openai_problem) — re-run: tts openai-key"
      fi
    else
      if [[ "$active_provider" == "openai" ]]; then
        _fail "OpenAI key missing from Keychain — run: tts openai-key"
      else
        _warn "OpenAI key not stored (ok — provider is $active_provider)"
      fi
    fi
  else
    _fail "venv missing — run: tts install"
  fi

  echo
  echo "== OpenAI model/voice pair =="
  local doc_model doc_voice
  doc_model=$(_openai_get_plist_value OPENAI_TTS_MODEL "gpt-4o-mini-tts")
  doc_voice=$(_openai_get_plist_value OPENAI_TTS_VOICE "nova")
  if _openai_voice_supported_by "$doc_model" "$doc_voice"; then
    _ok "voice '$doc_voice' is valid for model '$doc_model'"
  else
    _fail "voice '$doc_voice' is NOT supported by model '$doc_model' — run: tts openai-voices"
  fi
  local doc_instructions
  doc_instructions=$(_openai_get_plist_value OPENAI_TTS_INSTRUCTIONS "")
  if [[ -n "$doc_instructions" ]]; then
    if [[ "$doc_model" == "gpt-4o-mini-tts" ]]; then
      _ok "instructions set and active (model supports it)"
    else
      _warn "instructions set but model '$doc_model' ignores them (only gpt-4o-mini-tts applies)"
    fi
  fi

  echo
  echo "== Google provider =="
  # Problems are hard failures only when google is the active provider; otherwise
  # they are warnings, because the user may be preparing a later switch.
  _google_problem() {
    if [[ "$active_provider" == "google" ]]; then _fail "$1"; else _warn "$1"; fi
  }
  if [[ -x "$venv_py" ]]; then
    if "$venv_py" -c 'import httpx' >/dev/null 2>&1; then
      _ok "httpx importable"
    else
      _google_problem "httpx not importable — run: tts update"
    fi
    if "$venv_py" -c 'from zoneinfo import ZoneInfo; ZoneInfo("America/Los_Angeles")' >/dev/null 2>&1; then
      _ok "timezone database available (usage month uses America/Los_Angeles)"
    else
      _warn "timezone database missing — usage month falls back to fixed UTC-8"
    fi
  fi
  if _key_stored "$KEYCHAIN_ACCOUNT_GOOGLE"; then
    local google_problem
    google_problem=$(_key_shape_problem "$KEYCHAIN_ACCOUNT_GOOGLE")
    if [[ -z "$google_problem" ]]; then
      _ok "Google key present in Keychain (format looks valid)"
    else
      _google_problem "Google key in Keychain looks malformed ($google_problem) — re-run: tts google-key"
    fi
  else
    _google_problem "Google key not stored — run: tts google-key"
  fi
  local g_voice g_speed g_usage_file
  g_voice=$(_openai_get_plist_value GOOGLE_TTS_VOICE "ru-RU-Chirp3-HD-Aoede")
  if [[ "$g_voice" =~ ^[a-z]{2,3}-[A-Z]{2}-Chirp3-HD-[A-Za-z]+$ ]]; then
    _ok "google voice: $g_voice"
  else
    _google_problem "google voice '$g_voice' does not look like a Chirp 3 HD voice — run: tts google-voice"
  fi
  g_speed=$(_openai_get_plist_value GOOGLE_TTS_SPEED "1.0")
  if awk -v v="$g_speed" 'BEGIN{ exit !(v+0 >= 0.25 && v+0 <= 2.0) }'; then
    _ok "google speed: $g_speed (0.25-2.0)"
  else
    _google_problem "google speed '$g_speed' outside 0.25-2.0 (server clamps it) — run: tts google-speed"
  fi
  g_usage_file=$(_openai_get_plist_value GOOGLE_TTS_USAGE_FILE "$GOOGLE_USAGE_FILE_DEFAULT")
  if [[ -f "$g_usage_file" ]]; then
    if jq -e .chars "$g_usage_file" >/dev/null 2>&1; then
      _ok "usage file parses: $g_usage_file ($(jq -r '"\(.chars) chars in \(.month)"' "$g_usage_file"))"
    else
      _warn "usage file is unreadable JSON: $g_usage_file (server renames it to .corrupt and restarts from 0)"
    fi
  else
    _ok "no usage file yet (created on the first Google request)"
  fi

  echo
  echo "== launchd plist =="
  if [[ -f "$PLIST" ]]; then
    if plutil -lint "$PLIST" >/dev/null 2>&1; then
      _ok "plist exists and is valid: $PLIST"
    else
      _fail "plist exists but fails plutil -lint"
    fi
  else
    _fail "plist missing: $PLIST"
  fi

  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    local state
    state=$(launchctl print "$SERVICE" 2>/dev/null | awk -F' = ' '/state =/{print $2; exit}')
    if [[ "$state" == "running" ]]; then
      _ok "launchd: $AGENT_LABEL is running"
    else
      _fail "launchd: agent loaded but state=$state"
    fi
  else
    _fail "launchd: agent $AGENT_LABEL not loaded"
  fi

  echo
  echo "== HTTP server =="
  if health_ok; then
    _ok "/health OK on :$TTS_PORT"
    local port_owner
    port_owner=$(lsof -nP -iTCP:"$TTS_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)
    if [[ -n "$port_owner" ]]; then
      local cmd_name
      cmd_name=$(ps -p "$port_owner" -o command= 2>/dev/null)
      if echo "$cmd_name" | grep -q 'claude_code_tts.server'; then
        _ok "port $TTS_PORT owned by our server (PID $port_owner)"
      else
        _fail "port $TTS_PORT owned by different process (PID $port_owner): $cmd_name"
      fi
    fi
  else
    _fail "/health not responding on :$TTS_PORT"
  fi

  echo
  echo "== settings.json hooks =="
  local settings="$HOME/.claude/settings.json"
  if [[ -f "$settings" ]]; then
    local stop_cmd
    stop_cmd=$(_find_hook_command "$settings" Stop "$REPO_DIR/hooks/tts-stop.sh")
    if [[ -n "$stop_cmd" ]]; then
      _ok "Stop hook: $stop_cmd"
    else
      _fail "Stop hook is not registered — found: $(_list_hook_commands "$settings" Stop)"
    fi
    local sess_cmd
    sess_cmd=$(_find_hook_command "$settings" SessionStart "$REPO_DIR/hooks/tts-status.sh")
    if [[ -n "$sess_cmd" ]]; then
      _ok "SessionStart hook: $sess_cmd"
    else
      _fail "SessionStart hook is not registered — found: $(_list_hook_commands "$settings" SessionStart)"
    fi
  else
    _fail "settings.json missing: $settings"
  fi

  echo
  echo "== State + CLI =="
  if [[ -f "$TTS_FLAG" ]]; then
    local flag_val
    flag_val=$(cat "$TTS_FLAG")
    if [[ "$flag_val" == "0" || "$flag_val" == "1" ]]; then
      _ok "state file: $TTS_FLAG = $flag_val"
    else
      _fail "state file has unexpected value: $flag_val (expected 0 or 1)"
    fi
  else
    _warn "state file missing: $TTS_FLAG (tts on/off will create it)"
  fi

  local sym="$HOME/.local/bin/tts"
  if [[ -L "$sym" ]]; then
    local target
    target=$(readlink "$sym")
    if [[ "$target" == "$REPO_DIR/bin/tts" ]]; then
      _ok "symlink: $sym → $target"
    else
      _fail "symlink points elsewhere: $sym → $target"
    fi
  elif [[ -f "$sym" ]]; then
    _fail "$sym exists but is not a symlink"
  else
    _warn "$sym not installed (run: tts install)"
  fi

  echo
  if [[ "$fails" -eq 0 ]]; then
    echo "All checks passed."
    return 0
  else
    echo "$fails check(s) failed."
    return 1
  fi
}

# Single source of truth for subcommand help + dispatch.
# Adding a new command means: (1) a cmd_<name> function, (2) an entry here.
# usage() and dispatch are generated from this — no three-place edits.
COMMANDS=(
  on               "Enable TTS and (re)start the server"
  off              "Disable TTS and stop current playback"
  toggle           "Toggle on/off"
  status           "Show enabled flag + server + launchd state"
  test             "[text]  Synthesize and play a phrase (default: greeting)"
  restart          "Kick the launchd agent to restart the server"
  logs             "Tail server log"
  provider         "<edge-tts|openai|google>  Switch TTS provider and restart"
  voice            "<name>  [edge-tts] Switch voice (e.g. ru-RU-DmitryNeural) and restart"
  rate             "<val>   [edge-tts] Set speech rate (e.g. +15%, -10%) and restart"
  pitch            "<val>   [edge-tts] Set pitch (e.g. +50Hz, -20Hz) and restart"
  voices           "[edge-tts] List available ru/en voices"
  openai-key       "[openai]  Prompt for and store the OpenAI API key in Keychain"
  openai-key-clear "[openai]  Remove the OpenAI API key from Keychain"
  openai-voice     "<name>  [openai] Switch OpenAI voice (e.g. nova, alloy) and restart"
  openai-model     "<name>  [openai] Switch OpenAI model (tts-1|tts-1-hd|gpt-4o-mini-tts)"
  openai-voices    "[openai]  List available OpenAI voices"
  openai-instructions        "<text>  [openai/gpt-4o-mini-tts] Set tone/style hint (one line)"
  openai-instructions-clear  "[openai]  Remove the stored tone/style hint"
  openai-instructions-show   "[openai]  Print the stored tone/style hint"
  speed            "<val>   [openai] Set speech speed 0.25–4.0 (e.g. 1.25) and restart"
  google-key       "[google]  Prompt for and store the Google API key in Keychain"
  google-key-clear "[google]  Remove the Google API key from Keychain"
  google-voice     "<name>  [google] Switch Chirp 3 HD voice (e.g. ru-RU-Chirp3-HD-Aoede) and restart"
  google-speed     "<val>   [google] Set speech speed 0.25–2.0 (e.g. 1.1) and restart"
  tldr             "<on|off>  Speak only TL;DR block (silent if absent). Default: on"
  tldr-fallback        "<text>  Phrase spoken when TL;DR is missing (overrides silent-skip)"
  tldr-fallback-clear  "Remove the TL;DR fallback phrase (restore silent-skip)"
  tldr-fallback-show   "Print the stored TL;DR fallback phrase"
  reset            "Restore edge-tts voice/rate/pitch to defaults (single restart)"
  config           "Print current env values from plist"
  update           "git pull --rebase + install.sh (upgrade to latest)"
  doctor           "Diagnose setup: deps, venv, plist, hooks, port, state"
  install          "Run installer (creates venv, installs plist, patches settings.json)"
  uninstall        "Run uninstaller (reverse of install; --purge wipes state/venv)"
)

_command_exists() {
  local needle="$1" i
  for ((i = 0; i < ${#COMMANDS[@]}; i += 2)); do
    [[ "${COMMANDS[$i]}" == "$needle" ]] && return 0
  done
  return 1
}

usage() {
  echo "Usage: tts <command>"
  echo
  local i
  for ((i = 0; i < ${#COMMANDS[@]}; i += 2)); do
    printf "  %-18s %s\n" "${COMMANDS[$i]}" "${COMMANDS[$i + 1]}"
  done
  cat <<EOF

Files:
  flag:    $TTS_FLAG
  repo:    $REPO_DIR
  plist:   $PLIST
  logs:    $REPO_DIR/logs/server.log
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac

if ! _command_exists "$cmd"; then
  echo "unknown command: $cmd" >&2
  usage
  exit 2
fi

# Dispatch: cmd_<name>. Hyphens (if we ever add them) map to underscores.
"cmd_${cmd//-/_}" "$@"
