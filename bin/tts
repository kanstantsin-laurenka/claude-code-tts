#!/bin/bash
# Claude Code TTS control CLI.
# Two providers: edge-tts (default, free) and openai (paid, key from Keychain).
# edge-tts knobs: voice, rate, pitch.  openai knobs: openai-voice, openai-model, speed.
set -euo pipefail

KEYCHAIN_SERVICE="claude-code-tts"
KEYCHAIN_ACCOUNT_OPENAI="openai"

# Resolve symlinks so the CLI works when invoked via ~/.local/bin/tts too.
_self="$0"
while [[ -L "$_self" ]]; do
    _link="$(readlink "$_self")"
    if [[ "$_link" = /* ]]; then
        _self="$_link"
    else
        _self="$(cd "$(dirname "$_self")" && cd "$(dirname "$_link")" && pwd)/$(basename "$_link")"
    fi
done
REPO_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
TTS_FLAG="$HOME/.config/claude-code-tts/enabled"
TTS_PORT="${TTS_PORT:-7852}"
AGENT_LABEL="com.claude-code.tts"
PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"
UID_NUM="$(id -u)"
DOMAIN="gui/${UID_NUM}"
SERVICE="${DOMAIN}/${AGENT_LABEL}"

mkdir -p "$(dirname "$TTS_FLAG")"

have_agent() {
  launchctl print "$SERVICE" >/dev/null 2>&1
}
agent_running() {
  launchctl print "$SERVICE" 2>/dev/null | grep -q 'state = running'
}
health_ok() {
  curl -sf --max-time 1 "http://127.0.0.1:${TTS_PORT}/health" >/dev/null 2>&1
}

ensure_agent_loaded() {
  if ! have_agent; then
    if [[ -f "$PLIST" ]]; then
      launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null || true
    else
      echo "error: launchd plist missing at $PLIST — run: tts install" >&2
      return 1
    fi
  fi
}

cmd_on() {
  echo 1 > "$TTS_FLAG"
  ensure_agent_loaded
  if ! agent_running; then
    launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
  fi
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      echo "TTS: on (server healthy on :$TTS_PORT)"
      return 0
    fi
    sleep 0.5
  done
  echo "TTS: enabled, but server not responding on :$TTS_PORT yet — check: tts logs" >&2
}

cmd_off() {
  echo 0 > "$TTS_FLAG"
  curl -sf --max-time 1 -X POST "http://127.0.0.1:${TTS_PORT}/stop" >/dev/null 2>&1 || true
  echo "TTS: off (server left running; it's idle)"
}

cmd_toggle() {
  if [[ -f "$TTS_FLAG" ]] && [[ "$(cat "$TTS_FLAG")" == "1" ]]; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_status() {
  local enabled="no"
  [[ -f "$TTS_FLAG" ]] && [[ "$(cat "$TTS_FLAG")" == "1" ]] && enabled="yes"
  echo "enabled: $enabled"
  echo "flag:    $TTS_FLAG"
  echo "repo:    $REPO_DIR"
  if health_ok; then
    local info
    info=$(curl -sf --max-time 1 "http://127.0.0.1:${TTS_PORT}/health")
    echo "server:  running ($info)"
    local locked
    locked=$(echo "$info" | jq -r '.locked // false')
    if [[ "$locked" == "true" ]]; then
      echo "lock:    ACTIVE (microphone recording — TTS suppressed)"
    fi
  else
    echo "server:  down"
  fi
  if have_agent; then
    local state
    state=$(launchctl print "$SERVICE" 2>/dev/null | awk -F' = ' '/state =/{print $2; exit}')
    echo "launchd: loaded (state=${state:-unknown})"
  else
    echo "launchd: not loaded"
  fi
}

cmd_test() {
  local text="${1:-Привет. Это проверка голоса. Если ты это слышишь, всё работает.}"
  if ! health_ok; then
    echo "server is down — starting..." >&2
    cmd_on || true
  fi
  curl -sf --max-time 5 -X POST "http://127.0.0.1:${TTS_PORT}/speak" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg t "$text" '{text:$t}')" || {
      echo "speak failed" >&2
      return 1
    }
  echo
}

cmd_restart() {
  ensure_agent_loaded
  launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      echo "restarted"
      return 0
    fi
    sleep 0.5
  done
  echo "restart: server not responding yet — check: tts logs" >&2
}

cmd_install() {
  bash "$REPO_DIR/install.sh"
}

cmd_uninstall() {
  bash "$REPO_DIR/uninstall.sh" "$@"
}

cmd_logs() {
  local log="$REPO_DIR/logs/server.log"
  if [[ ! -f "$log" ]]; then
    echo "no logs yet at $log"
    return 0
  fi
  tail -n 50 -f "$log"
}

# Write one key into plist's EnvironmentVariables dict (no restart).
_set_env_value() {
  local key="$1" value="$2"
  if [[ ! -f "$PLIST" ]]; then
    echo "error: plist missing, run: tts install" >&2
    return 1
  fi
  /usr/libexec/PlistBuddy -c "Set :EnvironmentVariables:$key $value" "$PLIST" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:$key string $value" "$PLIST"
}

# Bootout + bootstrap launchd agent, wait for /health.
_reload_agent() {
  launchctl bootout "$DOMAIN" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "$DOMAIN" "$PLIST"
  for _ in 1 2 3 4 5 6; do
    if health_ok; then
      return 0
    fi
    sleep 0.5
  done
  echo "server not responding yet — check: tts logs" >&2
  return 1
}

_update_env() {
  _set_env_value "$1" "$2" && _reload_agent
}

cmd_voice() {
  local name="${1:?usage: tts voice <voice-name> (e.g. ru-RU-SvetlanaNeural, ru-RU-DmitryNeural, en-US-AriaNeural)}"
  _update_env TTS_VOICE "$name" && echo "voice: $name (server restarted)"
}

cmd_rate() {
  local value="${1:?usage: tts rate <value>  (e.g. +0%, +15%, -10%)}"
  if [[ ! "$value" =~ ^[+-][0-9]+%$ ]]; then
    echo "error: rate must look like +15% or -10%" >&2
    return 2
  fi
  _update_env TTS_RATE "$value" && echo "rate: $value (server restarted)"
}

cmd_pitch() {
  local value="${1:?usage: tts pitch <value>  (e.g. +0Hz, +50Hz, -20Hz)}"
  if [[ ! "$value" =~ ^[+-][0-9]+Hz$ ]]; then
    echo "error: pitch must look like +50Hz or -20Hz" >&2
    return 2
  fi
  _update_env TTS_PITCH "$value" && echo "pitch: $value (server restarted)"
}

cmd_voices() {
  local py="$REPO_DIR/venv/bin/python"
  if [[ ! -x "$py" ]]; then
    echo "venv missing — run: tts install" >&2
    return 1
  fi
  "$py" -c 'import asyncio, edge_tts; voices = asyncio.run(edge_tts.list_voices()); [print(v["ShortName"], "—", v.get("Gender",""), v.get("Locale","")) for v in voices if v["Locale"].startswith(("ru","en"))]'
}

cmd_provider() {
  local name="${1:?usage: tts provider <edge-tts|openai>}"
  case "$name" in
    edge-tts|openai) ;;
    *) echo "error: provider must be 'edge-tts' or 'openai'" >&2; return 2 ;;
  esac
  _update_env TTS_PROVIDER "$name" && echo "provider: $name (server restarted)"
}

cmd_openai_key() {
  local key
  printf "OpenAI API key: "
  IFS= read -rs key
  echo
  if [[ -z "$key" ]]; then
    echo "error: empty key, nothing stored" >&2
    return 2
  fi
  security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT_OPENAI" -w "$key" \
    && echo "OpenAI key stored in Keychain (service=$KEYCHAIN_SERVICE account=$KEYCHAIN_ACCOUNT_OPENAI)"
  if health_ok; then
    _reload_agent && echo "server restarted (key reloaded)"
  fi
}

cmd_openai_key_clear() {
  if security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT_OPENAI" 2>/dev/null; then
    echo "OpenAI key removed from Keychain"
  else
    echo "no OpenAI key was stored"
  fi
  if health_ok; then
    _reload_agent && echo "server restarted"
  fi
}

cmd_openai_voice() {
  local name="${1:?usage: tts openai-voice <name> (e.g. nova, alloy, echo)}"
  _update_env OPENAI_TTS_VOICE "$name" && echo "openai voice: $name (server restarted)"
}

cmd_openai_model() {
  local name="${1:?usage: tts openai-model <tts-1|tts-1-hd|gpt-4o-mini-tts>}"
  case "$name" in
    tts-1|tts-1-hd|gpt-4o-mini-tts) ;;
    *) echo "error: unknown model '$name' (expected tts-1, tts-1-hd, or gpt-4o-mini-tts)" >&2; return 2 ;;
  esac
  _update_env OPENAI_TTS_MODEL "$name" && echo "openai model: $name (server restarted)"
}

cmd_speed() {
  local value="${1:?usage: tts speed <value>  (0.25 to 4.0, e.g. 1.25)}"
  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "error: speed must be a positive number (e.g. 0.9, 1.25, 2.0)" >&2
    return 2
  fi
  # OpenAI accepts 0.25–4.0; bounds-check here so errors surface before restart.
  awk -v v="$value" 'BEGIN{ if (v+0 < 0.25 || v+0 > 4.0) exit 1 }' || {
    echo "error: speed must be between 0.25 and 4.0" >&2
    return 2
  }
  _update_env OPENAI_TTS_SPEED "$value" && echo "openai speed: $value (server restarted)"
}

cmd_openai_voices() {
  cat <<'EOF'
OpenAI TTS voices (11):
  alloy  ash  ballad  coral  echo  fable  nova  onyx  sage  shimmer  verse
Switch with: tts openai-voice <name>
EOF
}

cmd_reset() {
  # Resets edge-tts knobs only. Does not touch TTS_PROVIDER, OpenAI settings,
  # or the Keychain-stored key.
  _set_env_value TTS_VOICE "ru-RU-SvetlanaNeural" || return 1
  _set_env_value TTS_RATE  "+0%"                  || return 1
  _set_env_value TTS_PITCH "+0Hz"                 || return 1
  _reload_agent && echo "reset: voice=ru-RU-SvetlanaNeural, rate=+0%, pitch=+0Hz (edge-tts knobs only)"
}

cmd_config() {
  if [[ ! -f "$PLIST" ]]; then
    echo "plist missing, run: tts install" >&2
    return 1
  fi
  echo "Config from $PLIST"
  echo "(edit with 'tts provider|voice|rate|pitch|openai-voice|openai-model|speed' or PlistBuddy + 'tts restart')"
  echo
  local keys=(
    TTS_PROVIDER
    TTS_VOICE TTS_RATE TTS_PITCH
    OPENAI_TTS_MODEL OPENAI_TTS_VOICE OPENAI_TTS_SPEED
    TTS_MAX_CHARS TTS_PORT TTS_LOCK_FILE TTS_RESPECT_LOCK PYTHONPATH
  )
  local key val
  for key in "${keys[@]}"; do
    val=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$PLIST" 2>/dev/null || echo "(unset)")
    printf "  %-18s = %s\n" "$key" "$val"
  done
  echo
  if security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT_OPENAI" >/dev/null 2>&1; then
    echo "  OpenAI key         = (stored in Keychain)"
  else
    echo "  OpenAI key         = (not stored — run: tts openai-key)"
  fi
}

cmd_update() {
  if ! git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    echo "error: $REPO_DIR is not a git checkout — can't update" >&2
    return 1
  fi
  echo "→ git pull --rebase in $REPO_DIR"
  if ! git -C "$REPO_DIR" pull --rebase; then
    echo "update: git pull failed (resolve conflicts, then re-run)" >&2
    return 1
  fi
  echo "→ running install.sh"
  bash "$REPO_DIR/install.sh"
}

cmd_doctor() {
  local fails=0
  _ok()   { printf '  \033[0;32m✓\033[0m %s\n' "$1"; }
  _fail() { printf '  \033[0;31m✗\033[0m %s\n' "$1" >&2; fails=$((fails + 1)); }
  _warn() { printf '  \033[1;33m!\033[0m %s\n' "$1"; }

  echo "== Dependencies =="
  for bin in python3 afplay jq git curl launchctl; do
    if command -v "$bin" >/dev/null 2>&1; then
      _ok "$bin: $(command -v "$bin")"
    else
      _fail "$bin not on PATH"
    fi
  done
  if command -v python3 >/dev/null 2>&1; then
    local py_ver
    py_ver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    local maj min
    maj=$(echo "$py_ver" | cut -d. -f1)
    min=$(echo "$py_ver" | cut -d. -f2)
    if [[ "$maj" -ge 3 ]] && [[ "$min" -ge 10 ]]; then
      _ok "python3 version: $py_ver (>= 3.10 required)"
    else
      _fail "python3 version: $py_ver — need >= 3.10"
    fi
  fi

  echo
  echo "== Repo =="
  _ok "repo: $REPO_DIR"
  if [[ -d "$REPO_DIR/.git" ]]; then
    local branch origin
    branch=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    origin=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "(no origin)")
    _ok "git branch: $branch, origin: $origin"
  else
    _warn "not a git checkout — 'tts update' will not work"
  fi

  echo
  echo "== venv + providers =="
  local venv_py="$REPO_DIR/venv/bin/python"
  local active_provider="edge-tts"
  if [[ -f "$PLIST" ]]; then
    active_provider=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:TTS_PROVIDER" "$PLIST" 2>/dev/null || echo "edge-tts")
  fi
  _ok "active provider: $active_provider"
  if [[ -x "$venv_py" ]]; then
    _ok "venv python: $venv_py"
    if "$venv_py" -c 'import edge_tts; print(edge_tts.__version__)' 2>/dev/null >/dev/null; then
      local v
      v=$("$venv_py" -c 'import edge_tts; print(edge_tts.__version__)')
      _ok "edge-tts importable (version $v)"
    else
      _fail "edge-tts not importable — run: tts install"
    fi
    if "$venv_py" -c 'import openai; print(openai.__version__)' 2>/dev/null >/dev/null; then
      local ov
      ov=$("$venv_py" -c 'import openai; print(openai.__version__)')
      _ok "openai importable (version $ov)"
    else
      if [[ "$active_provider" == "openai" ]]; then
        _fail "openai not importable but provider=openai — run: tts update"
      else
        _warn "openai not importable (ok — provider is $active_provider; run 'tts update' to install)"
      fi
    fi
    if security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT_OPENAI" >/dev/null 2>&1; then
      _ok "OpenAI key present in Keychain"
    else
      if [[ "$active_provider" == "openai" ]]; then
        _fail "OpenAI key missing from Keychain — run: tts openai-key"
      else
        _warn "OpenAI key not stored (ok — provider is $active_provider)"
      fi
    fi
  else
    _fail "venv missing — run: tts install"
  fi

  echo
  echo "== launchd plist =="
  if [[ -f "$PLIST" ]]; then
    if plutil -lint "$PLIST" >/dev/null 2>&1; then
      _ok "plist exists and is valid: $PLIST"
    else
      _fail "plist exists but fails plutil -lint"
    fi
  else
    _fail "plist missing: $PLIST"
  fi

  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    local state
    state=$(launchctl print "$SERVICE" 2>/dev/null | awk -F' = ' '/state =/{print $2; exit}')
    if [[ "$state" == "running" ]]; then
      _ok "launchd: $AGENT_LABEL is running"
    else
      _fail "launchd: agent loaded but state=$state"
    fi
  else
    _fail "launchd: agent $AGENT_LABEL not loaded"
  fi

  echo
  echo "== HTTP server =="
  if health_ok; then
    _ok "/health OK on :$TTS_PORT"
    local port_owner
    port_owner=$(lsof -nP -iTCP:"$TTS_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)
    if [[ -n "$port_owner" ]]; then
      local cmd_name
      cmd_name=$(ps -p "$port_owner" -o command= 2>/dev/null)
      if echo "$cmd_name" | grep -q 'claude_code_tts.server'; then
        _ok "port $TTS_PORT owned by our server (PID $port_owner)"
      else
        _fail "port $TTS_PORT owned by different process (PID $port_owner): $cmd_name"
      fi
    fi
  else
    _fail "/health not responding on :$TTS_PORT"
  fi

  echo
  echo "== settings.json hooks =="
  local settings="$HOME/.claude/settings.json"
  if [[ -f "$settings" ]]; then
    local stop_cmd
    stop_cmd=$(jq -r '.hooks.Stop[0].hooks[0].command // "(none)"' "$settings" 2>/dev/null)
    if [[ "$stop_cmd" == *"$REPO_DIR/hooks/tts-stop.sh"* ]]; then
      _ok "Stop hook: $stop_cmd"
    else
      _fail "Stop hook is not ours — got: $stop_cmd"
    fi
    local sess_cmd
    sess_cmd=$(jq -r '.hooks.SessionStart[0].hooks[0].command // "(none)"' "$settings" 2>/dev/null)
    if [[ "$sess_cmd" == *"$REPO_DIR/hooks/tts-status.sh"* ]]; then
      _ok "SessionStart hook: $sess_cmd"
    else
      _fail "SessionStart hook is not ours — got: $sess_cmd"
    fi
  else
    _fail "settings.json missing: $settings"
  fi

  echo
  echo "== State + CLI =="
  if [[ -f "$TTS_FLAG" ]]; then
    local flag_val
    flag_val=$(cat "$TTS_FLAG")
    if [[ "$flag_val" == "0" || "$flag_val" == "1" ]]; then
      _ok "state file: $TTS_FLAG = $flag_val"
    else
      _fail "state file has unexpected value: $flag_val (expected 0 or 1)"
    fi
  else
    _warn "state file missing: $TTS_FLAG (tts on/off will create it)"
  fi

  local sym="$HOME/.local/bin/tts"
  if [[ -L "$sym" ]]; then
    local target
    target=$(readlink "$sym")
    if [[ "$target" == "$REPO_DIR/bin/tts" ]]; then
      _ok "symlink: $sym → $target"
    else
      _fail "symlink points elsewhere: $sym → $target"
    fi
  elif [[ -f "$sym" ]]; then
    _fail "$sym exists but is not a symlink"
  else
    _warn "$sym not installed (run: tts install)"
  fi

  echo
  if [[ "$fails" -eq 0 ]]; then
    echo "All checks passed."
    return 0
  else
    echo "$fails check(s) failed."
    return 1
  fi
}

# Single source of truth for subcommand help + dispatch.
# Adding a new command means: (1) a cmd_<name> function, (2) an entry here.
# usage() and dispatch are generated from this — no three-place edits.
COMMANDS=(
  on               "Enable TTS and (re)start the server"
  off              "Disable TTS and stop current playback"
  toggle           "Toggle on/off"
  status           "Show enabled flag + server + launchd state"
  test             "[text]  Synthesize and play a phrase (default: greeting)"
  restart          "Kick the launchd agent to restart the server"
  logs             "Tail server log"
  provider         "<edge-tts|openai>  Switch TTS provider and restart"
  voice            "<name>  [edge-tts] Switch voice (e.g. ru-RU-DmitryNeural) and restart"
  rate             "<val>   [edge-tts] Set speech rate (e.g. +15%, -10%) and restart"
  pitch            "<val>   [edge-tts] Set pitch (e.g. +50Hz, -20Hz) and restart"
  voices           "[edge-tts] List available ru/en voices"
  openai-key       "[openai]  Prompt for and store the OpenAI API key in Keychain"
  openai-key-clear "[openai]  Remove the OpenAI API key from Keychain"
  openai-voice     "<name>  [openai] Switch OpenAI voice (e.g. nova, alloy) and restart"
  openai-model     "<name>  [openai] Switch OpenAI model (tts-1|tts-1-hd|gpt-4o-mini-tts)"
  openai-voices    "[openai]  List available OpenAI voices"
  speed            "<val>   [openai] Set speech speed 0.25–4.0 (e.g. 1.25) and restart"
  reset            "Restore edge-tts voice/rate/pitch to defaults (single restart)"
  config           "Print current env values from plist"
  update           "git pull --rebase + install.sh (upgrade to latest)"
  doctor           "Diagnose setup: deps, venv, plist, hooks, port, state"
  install          "Run installer (creates venv, installs plist, patches settings.json)"
  uninstall        "Run uninstaller (reverse of install; --purge wipes state/venv)"
)

_command_exists() {
  local needle="$1" i
  for ((i = 0; i < ${#COMMANDS[@]}; i += 2)); do
    [[ "${COMMANDS[$i]}" == "$needle" ]] && return 0
  done
  return 1
}

usage() {
  echo "Usage: tts <command>"
  echo
  local i
  for ((i = 0; i < ${#COMMANDS[@]}; i += 2)); do
    printf "  %-18s %s\n" "${COMMANDS[$i]}" "${COMMANDS[$i + 1]}"
  done
  cat <<EOF

Files:
  flag:    $TTS_FLAG
  repo:    $REPO_DIR
  plist:   $PLIST
  logs:    $REPO_DIR/logs/server.log
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac

if ! _command_exists "$cmd"; then
  echo "unknown command: $cmd" >&2
  usage
  exit 2
fi

# Dispatch: cmd_<name>. Hyphens (if we ever add them) map to underscores.
"cmd_${cmd//-/_}" "$@"
