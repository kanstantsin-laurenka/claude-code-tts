#!/bin/bash
# PRE-PUSH: run the pytest suite before any `git push`.
#
# Why: after rebase we force-pushed once with two broken fixtures and had to
# chase the CI red. Catching it locally shaves a round-trip.
#
# Escape hatch: `git push --no-verify` skips this hook. The hook is also
# silently skipped on branch deletes (no local refs to test).
#
# If venv is missing we warn and allow the push instead of blocking, since
# docs-only / CI-config branches shouldn't need a working dev environment.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV_PY="$REPO_ROOT/venv/bin/python"

# Read stdin (git feeds one line per ref being pushed) and skip if every
# local SHA is zero — i.e. this is purely a branch deletion push.
all_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
    all_deletes=0
  fi
done
if [[ "$all_deletes" -eq 1 ]]; then
  exit 0
fi

if [[ ! -x "$VENV_PY" ]]; then
  echo "pre-push: venv missing at $VENV_PY — skipping tests (run scripts/dev-setup.sh to enable)" >&2
  exit 0
fi

echo "pre-push: running pytest (skip with --no-verify)..." >&2
if ! "$VENV_PY" -m pytest tests/ -q; then
  echo "" >&2
  echo "pre-push: tests failed — push blocked. Fix or re-run with --no-verify." >&2
  exit 1
fi
